# Server-only values. Never use a VITE_ prefix for the API key.
XAI_API_KEY=
XAI_MODEL=grok-4.7
AGENT_PORT=8787
# Optional comma-separated browser origins; defaults include localhost ports 5173/4173.
# AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
# Render automatically supplies PORT and RENDER_EXTERNAL_HOSTNAME.
# Set AGENT_ALLOWED_ORIGINS to your Static Site URL on Render.
# Optional extra hostnames if you add an agent custom domain:
# AGENT_ALLOWED_HOSTS=agent.example.com
